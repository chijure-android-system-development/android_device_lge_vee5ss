# LG L5 II (vee5ss): everything shared with the L4 II lives in
# device/lge/mt6575-common/rootdir/root/init.mt6575.common.rc.
import /init.mt6575.common.rc

# Magnetometer daemon of this board's BMM050 compass
service bmm050d /system/bin/bmm050d
    class main
    user system
    group system
    oneshot
