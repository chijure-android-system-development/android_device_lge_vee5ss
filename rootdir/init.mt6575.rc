import /init.mt6575.usb.rc

on early-init
    write /dev/kmsg "CMBOOT: early-init\n"
    mount debugfs debugfs /sys/kernel/debug

on init
    write /dev/kmsg "CMBOOT: init\n"
    # Almacenamiento interno via sdcard FUSE daemon — monta en /storage/sdcard0
    mkdir /storage 0755 root root
    mkdir /storage/sdcard0 0775 system system

    export EXTERNAL_STORAGE /storage/sdcard0

    # MicroSD externo
    mkdir /storage/sdcard1 0775 system system
    export SECONDARY_STORAGE /storage/sdcard1

    symlink /storage/sdcard0 /sdcard
    symlink /storage/sdcard0 /mnt/sdcard
    symlink /storage/sdcard1 /external_sd
    symlink /storage/sdcard1 /mnt/external_sd

on fs
    write /dev/kmsg "CMBOOT: fs - before mount_all\n"
    mount_all /fstab.mt6575
    write /dev/kmsg "CMBOOT: fs - after mount_all\n"
    setprop ro.crypto.fuse_sdcard true

on post-fs
    # NVRAM (calibración WiFi y BT) — montaje manual; vold no lo maneja
    mkdir /data/nvram 0770 root nvram

on post-fs-data
    # MTP / USB media
    mkdir /data/media 0770 media_rw media_rw

    # Wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp

    # BT
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth

    setprop vold.post_fs_data_done 1

on boot
    write /dev/kmsg "CMBOOT: boot - loading modules\n"
    # Kernel modules — cargar antes de que arranquen los servicios
    insmod /system/lib/modules/pvrsrvkm.ko
    chmod 0666 /dev/pvrsrvkm
    insmod /system/lib/modules/mtklfb.ko
    insmod /system/lib/modules/mtk_drvb.ko
    insmod /system/lib/modules/ccci_plat.ko
    insmod /system/lib/modules/ccci.ko
    insmod /system/lib/modules/ccmni.ko
    insmod /system/lib/modules/m4u.ko
    insmod /system/lib/modules/vcodec_kernel_driver.ko
    insmod /system/lib/modules/sec.ko
    insmod /system/lib/modules/devinfo.ko
    insmod /system/lib/modules/mtk_hif_sdio.ko
    insmod /system/lib/modules/mtk_stp_wmt.ko
    insmod /system/lib/modules/mtk_stp_uart.ko
    insmod /system/lib/modules/mtk_stp_gps.ko
    insmod /system/lib/modules/mtk_stp_bt.ko
    insmod /system/lib/modules/mtk_wmt_wifi.ko
    insmod /system/lib/modules/wlan.ko

    # Camera / MHAL / MDP nodes. M4U registers in /proc/devices but does not
    # always emit a uevent on this stock kernel, so create it explicitly.
    mknod /dev/M4U_device c 188 0
    chown system camera /dev/kd_camera_hw
    chown system camera /dev/FM50AF
    chown system camera /dev/kd_camera_flashlight
    chown system camera /dev/camera-resmgr
    chown system camera /dev/camera-sysram
    chown system camera /dev/camera-isp
    chown system camera /dev/camera-eis
    chown system camera /dev/camera-fdvt
    chown system media /dev/mt-mdp
    chown system camera /dev/mtk_jpeg
    chown system media /dev/M4U_device
    chown root media /proc/clkmgr/mipi_test
    chown system media /sys/bus/platform/drivers/mem_bw_ctrl/concurrency_scenario
    chmod 0660 /dev/kd_camera_hw
    chmod 0660 /dev/FM50AF
    chmod 0660 /dev/kd_camera_flashlight
    chmod 0660 /dev/camera-resmgr
    chmod 0660 /dev/camera-sysram
    chmod 0660 /dev/camera-isp
    chmod 0660 /dev/camera-eis
    chmod 0660 /dev/camera-fdvt
    chmod 0660 /dev/mt-mdp
    chmod 0444 /dev/mtk_jpeg
    chmod 0444 /dev/M4U_device

    # CCCI modem device nodes
    mknod /dev/ccci_fs c 178 0
    mknod /dev/ccci_rpc c 178 1
    mknod /dev/ccci_sys_rx c 184 2
    mknod /dev/ccci_sys_tx c 184 3
    mknod /dev/ccci_pcm_rx c 184 4
    mknod /dev/ccci_pcm_tx c 184 5
    mknod /dev/ccci_ipc_1220_0 c 183 0
    mknod /dev/ccci_uem_rx c 184 18
    mknod /dev/ccci_uem_tx c 184 19
    mknod /dev/ccci_md_log_rx c 184 42
    mknod /dev/ccci_md_log_tx c 184 43
    chmod 0660 /dev/ccci_fs
    chmod 0660 /dev/ccci_rpc
    chmod 0660 /dev/ccci_sys_rx
    chmod 0660 /dev/ccci_sys_tx
    chmod 0660 /dev/ccci_pcm_rx
    chmod 0660 /dev/ccci_pcm_tx
    chmod 0660 /dev/ccci_ipc_1220_0
    chmod 0660 /dev/ccci_uem_rx
    chmod 0660 /dev/ccci_uem_tx
    chmod 0660 /dev/ccci_md_log_rx
    chmod 0660 /dev/ccci_md_log_tx
    chmod 0660 /dev/ttyC0
    chmod 0660 /dev/ttyC1
    chmod 0660 /dev/ttyC2
    chown radio radio /dev/ccci_fs
    chown radio radio /dev/ccci_rpc
    chown radio radio /dev/ccci_sys_rx
    chown radio radio /dev/ccci_sys_tx
    chown radio radio /dev/ccci_pcm_rx
    chown radio radio /dev/ccci_pcm_tx
    chown radio radio /dev/ccci_ipc_1220_0
    chown radio radio /dev/ccci_uem_rx
    chown radio radio /dev/ccci_uem_tx
    chown radio radio /dev/ccci_md_log_rx
    chown radio radio /dev/ccci_md_log_tx
    chown radio radio /dev/ttyC0
    chown radio radio /dev/ttyC1
    chown radio radio /dev/ttyC2
    chown radio radio /sys/class/BOOT/BOOT/boot/md
    mkdir /dev/radio 0770 radio radio
    mkdir /data/nvram/md 0770 root root

    write /dev/kmsg "CMBOOT: boot - modules done, starting services\n"

    # CPU governor
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive

    # Backlight
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0660 /sys/class/leds/lcd-backlight/brightness

    # Button backlight — desactivar el blink que el kernel MTK activa por defecto
    write /sys/class/leds/button-backlight/trigger none
    write /sys/class/leds/button-backlight/brightness 0

    # Red LP5521 (LEDs de notificación)
    chown system system /sys/class/leds/R/brightness
    chown system system /sys/class/leds/G/brightness
    chown system system /sys/class/leds/B/brightness
    chmod 0660 /sys/class/leds/R/brightness
    chmod 0660 /sys/class/leds/G/brightness
    chmod 0660 /sys/class/leds/B/brightness

    # MTK ALPS sensor hub — sensors.mt6575.so solo usa /dev/hwmsensor
    chown system system /dev/hwmsensor
    chown system system /dev/gsensor
    chown system system /dev/msensor
    chmod 0660 /dev/hwmsensor
    chmod 0660 /dev/gsensor
    chmod 0660 /dev/msensor

    # Permisos de dispositivos MTK
    chmod 0660 /dev/nvram
    chown root nvram /dev/nvram

    # libmtk_drvb.so requires /dev/devmap for DRM/integrity checks
    mknod /dev/devmap c 196 0
    chmod 0666 /dev/devmap

    # nvram_daemon exits without setting nvram_init=Ready on this port because
    # the raw /dev/nvram partition has no audio calibration records. Force-set
    # the property so libaudiocustparam.so uses existing /data/nvram/ files.
    setprop nvram_init Ready

    # Bluetooth
    chmod 0660 /dev/ttyMT2
    chown bluetooth bluetooth /dev/ttyMT2

    # Vibrador
    chown system system /sys/class/timed_output/vibrator/enable

    # GPU init — before class_start so SurfaceFlinger gets a ready GPU
    exec /system/vendor/bin/pvrsrvctl --start

    # Clase de inicio para servicios del sistema
    class_start default

service ccci_rpcd /system/bin/ccci_rpcd
    class core
    user root
    group radio system
    oneshot

service ccci_fsd /system/bin/ccci_fsd
    class core
    user root
    group radio system
    oneshot

service ccci_mdinit /system/bin/ccci_mdinit
    class core
    user root
    group radio system
    oneshot

service gsm0710muxd /system/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    class core
    user root
    group radio system
    disabled

service ril-daemon /system/bin/rild
    class main
    socket rild stream 660 root radio
    socket rild-debug stream 660 radio system
    user root
    group radio cache inet misc audio sdcard_rw log

service nvram_daemon /system/bin/nvram_daemon
    class core
    user root
    group nvram system
    oneshot

service media /system/bin/mediaserver
    class main
    socket soc_vt_tcv dgram 660 media system
    socket soc_vt_stk dgram 660 media system
    socket soc_vt_svc dgram 660 media system
    user root
    group audio camera graphics inet net_bt net_bt_admin net_bw_acct drmrpc media sdcard_rw nvram ccci radio
    ioprio rt 4

# sdcard daemon — emula FAT en /data/media via FUSE, monta en /storage/sdcard0
service sdcard /system/bin/sdcard /data/media 1023 1023
    class late_start

service wpa_supplicant /system/bin/wpa_supplicant \
    -Dnl80211 -iwlan0 -puse_p2p_group_interface=1 -e/data/misc/wifi/entropy.bin
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABDKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot
